# ===================================================================
# Course Management System - Environment Variables Template
# Copy this file to .env or export these variables in your environment
# ===================================================================

# PostgreSQL Container Configuration (for Docker Compose)
POSTGRES_DB=final_project_03
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Database Configuration (for running Spring Boot locally without Docker)
DB_URL=jdbc:postgresql://localhost:5432/final_project_03
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# JWT Security Configuration
# IMPORTANT: JwtProvider uses Decoders.BASE64.decode() and Keys.hmacShaKeyFor().
# Therefore, JWT_SECRET MUST be a Base64-encoded string with at least 256 bits (32 bytes).
# You can generate a valid key using:
#   - Linux/macOS/Git Bash: openssl rand -base64 32
#   - PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_EXPIRATION=300000
JWT_REFRESH_EXPIRATION=604800000

# Gmail SMTP Configuration (for OTP verification and password reset)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_google_app_password

# Cloudinary Configuration (for uploading lesson videos and PDF attachments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# This key is only a local learning example. Generate a new value before deployment.
